@*
    页面顶部统一模式：标题（页面唯一 h1）、一句话说明和主要操作区。
    需要层级时使用 Breadcrumbs 提供面包屑，不要在标题里拼接路径。
*@
<div class="page-header" data-testid="page-header">
    <div class="page-header__text">
        @if (Breadcrumbs is not null)
        {
            <nav class="page-header__breadcrumbs" aria-label="面包屑">
                @Breadcrumbs
            </nav>
        }
        <MudText Typo="Typo.h4" HtmlTag="h1" Class="page-header__title">@Title</MudText>
        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <MudText Typo="Typo.body2"
                     Class="mud-text-secondary"
                     data-testid="page-header-description">
                @Description
            </MudText>
        }
    </div>
    @if (Actions is not null)
    {
        <div class="page-header__actions">
            @Actions
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public RenderFragment? Breadcrumbs { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }
}
