@*
    查询成功但没有数据时的统一占位。空态与失败态必须区分，
    不能把空结果显示成错误，也不能把错误显示成空结果。
*@
<div class="app-state" data-testid="empty-state">
    <MudIcon Icon="@Icon" Color="Color.Default" Size="Size.Large" />
    <MudText Typo="Typo.subtitle1">@Title</MudText>
    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary" data-testid="empty-state-description">
            @Description
        </MudText>
    }
    @if (Actions is not null)
    {
        <div class="app-state-actions">
            @Actions
        </div>
    }
</div>

@code {
    [Parameter]
    public string Title { get; set; } = "暂无数据";

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public string Icon { get; set; } = Icons.Material.Outlined.Inbox;

    [Parameter]
    public RenderFragment? Actions { get; set; }
}
