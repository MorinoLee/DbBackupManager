@page "/file-credentials"
@attribute [Authorize(Policy = AdminAuthenticationDefaults.AuthorizationPolicy)]
@implements IDisposable
@using DbBackupManager.Application.FileCredentials
@using DbBackupManager.Web.Authentication
@using DbBackupManager.Web.FileCredentials
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject IFileCredentialService Credentials
@inject AuthenticationStateProvider Authentication
@inject IDialogService Dialogs

<PageTitle>暂存访问凭据 · DbBackupManager</PageTitle>

<AuthorizeView Policy="@AdminAuthenticationDefaults.AuthorizationPolicy">
    <Authorized Context="authState">
        <MudStack Spacing="3">
            <PageHeader Title="暂存访问凭据"
                        Description="集中保存 SMB 密码、SFTP 密码或 SFTP 私钥，供服务器暂存访问和存储目标使用。保存后的密码、私钥和口令不会显示。">
                <Actions>
                    @if (!_requiresLogin)
                    {
                        <MudButton OnClick="RefreshAsync"
                                   Disabled="_busy"
                                   Variant="Variant.Outlined"
                                   StartIcon="@Icons.Material.Outlined.Refresh"
                                   data-testid="refresh-credentials">
                            刷新
                        </MudButton>
                        <MudButton OnClick="@(() => OpenEditorAsync(null))"
                                   Disabled="_busy"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Outlined.Add"
                                   data-testid="new-credential">
                            新建凭据
                        </MudButton>
                    }
                </Actions>
            </PageHeader>
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" role="alert">@_error</MudAlert>
            }
            @if (_message is not null)
            {
                <MudAlert Severity="Severity.Success" role="status">@_message</MudAlert>
            }
            @if (_requiresLogin)
            {
                <MudButton Href="/login?returnUrl=/file-credentials" Variant="Variant.Filled" Color="Color.Primary">重新登录</MudButton>
            }
            else
            {
                <MudTable T="FileCredentialItem" Items="_items" Loading="_busy" Hover="true" Breakpoint="Breakpoint.Sm">
                    <HeaderContent>
                        <MudTh>协议</MudTh><MudTh>名称</MudTh><MudTh>文件访问用户名</MudTh><MudTh>状态</MudTh><MudTh>操作</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="item">
                        <MudTd DataLabel="协议">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">
                                @FileCredentialPresentation.Kind(item.Kind)
                            </MudChip>
                            @if (item.Kind == FileCredentialKind.SftpPrivateKey && item.HasPassphrase)
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">已设置口令</MudText>
                            }
                        </MudTd>
                        <MudTd DataLabel="名称">@item.Name</MudTd>
                        <MudTd DataLabel="文件访问用户名">@item.Username</MudTd>
                        <MudTd DataLabel="状态">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                     Color="@(item.IsEnabled ? Color.Success : Color.Default)">
                                @(item.IsEnabled ? "已启用" : "已停用")
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="操作">
                            <MudButton Size="Size.Small" Disabled="@_busy" OnClick="@(() => OpenEditorAsync(item))"
                                       data-testid="@(item.Kind == FileCredentialKind.SftpPrivateKey ? "rotate-private-key" : "rotate-password")">
                                @(item.Kind == FileCredentialKind.SftpPrivateKey ? "更新私钥" : "更新密码")
                            </MudButton>
                            <MudButton Size="Size.Small" Disabled="@_busy" OnClick="@(() => ToggleAsync(item))" data-testid="toggle-credential">@(item.IsEnabled ? "停用" : "启用")</MudButton>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent><MudText Class="pa-4">暂无暂存访问凭据，点击“新建凭据”添加。</MudText></NoRecordsContent>
                </MudTable>
            }
        </MudStack>
    </Authorized>
    <NotAuthorized><MudAlert Severity="Severity.Info">请先登录管理员账号。</MudAlert></NotAuthorized>
</AuthorizeView>

@code {
    private static readonly DialogOptions EditorOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true };

    private readonly CancellationTokenSource _lifetime = new();
    private IReadOnlyList<FileCredentialItem> _items = [];
    private bool _busy;
    private bool _requiresLogin;
    private bool _disposed;
    private string? _error;
    private string? _message;

    protected override Task OnInitializedAsync() => RefreshAsync();

    private async Task RunAsync(Func<DbBackupManager.Application.Identity.AdminSession, Task> action)
    {
        if (_busy || _disposed) { return; }
        _busy = true;
        _error = null;
        _message = null;
        try
        {
            var state = await Authentication.GetAuthenticationStateAsync();
            var actor = FileCredentialPresentation.GetActor(state.User);
            if (actor is null) { ShowFailure(FileCredentialResultCode.AuthenticationRequired); return; }
            await action(actor);
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception) { ShowFailure(FileCredentialResultCode.Unavailable); }
        finally { _busy = false; }
    }

    private Task RefreshAsync() => RunAsync(async actor =>
    {
        var result = await Credentials.ListAsync(actor, _lifetime.Token);
        if (_disposed) { return; }
        if (result.Code == FileCredentialResultCode.Succeeded) { _items = result.Value!; }
        else { _items = []; ShowFailure(result.Code); }
    });

    private async Task OpenEditorAsync(FileCredentialItem? item)
    {
        if (_busy || _disposed) { return; }
        _message = null;
        var model = new FileCredentialFormModel();
        if (item is not null)
        {
            model.Kind = item.Kind;
            model.Name = item.Name;
            model.Username = item.Username;
        }

        var title = item is null
            ? "新建暂存访问凭据"
            : item.Kind == FileCredentialKind.SftpPrivateKey ? $"更新私钥：{item.Name}" : $"更新密码：{item.Name}";
        var parameters = new DialogParameters<FileCredentialEditDialog>
        {
            { dialog => dialog.Title, title },
            { dialog => dialog.Model, model },
            { dialog => dialog.IsCreate, item is null },
            { dialog => dialog.OnSave, (FileCredentialFormModel input) => SaveAsync(item, input) },
        };
        var dialog = await Dialogs.ShowAsync<FileCredentialEditDialog>(title, parameters, EditorOptions);
        await dialog.Result;
    }

    /// <summary>
    /// 弹窗保存委托：返回 null 表示成功或编辑流程必须结束，否则返回中文错误并保持弹窗与输入。
    /// 身份失效不同于普通校验失败：清空受保护列表、关闭编辑流程并给出重新登录入口。
    /// </summary>
    private async Task<string?> SaveAsync(FileCredentialItem? selected, FileCredentialFormModel input)
    {
        _error = null;
        _message = null;
        var actor = FileCredentialPresentation.GetActor((await Authentication.GetAuthenticationStateAsync()).User);
        if (actor is null)
        {
            ShowFailure(FileCredentialResultCode.AuthenticationRequired);
            return null;
        }

        var result = selected is null
            ? input.IsPrivateKey
                ? await Credentials.CreatePrivateKeyAsync(actor, input.Name, input.Username, input.PrivateKey, input.Passphrase, _lifetime.Token)
                : await Credentials.CreateAsync(actor, input.Name, input.Username, input.Kind, input.Password, _lifetime.Token)
            : selected.Kind == FileCredentialKind.SftpPrivateKey
                ? await Credentials.RotatePrivateKeyAsync(actor, selected.Id, selected.Version, input.PrivateKey, input.Passphrase, _lifetime.Token)
                : await Credentials.RotatePasswordAsync(actor, selected.Id, selected.Version, input.Password, _lifetime.Token);
        if (_disposed) { return null; }
        if (result.Code == FileCredentialResultCode.AuthenticationRequired)
        {
            ShowFailure(result.Code);
            return null;
        }

        if (result.Code != FileCredentialResultCode.Succeeded)
        {
            return FileCredentialPresentation.Error(result.Code).Message;
        }

        Upsert(result.Value!);
        _message = "凭据已保存。";
        return null;
    }

    private Task ToggleAsync(FileCredentialItem item) => RunAsync(async actor =>
    {
        var result = await Credentials.SetEnabledAsync(actor, item.Id, item.Version, !item.IsEnabled, _lifetime.Token);
        if (_disposed) { return; }
        if (result.Code != FileCredentialResultCode.Succeeded) { ShowFailure(result.Code); return; }
        Upsert(result.Value!);
        _message = result.Value!.IsEnabled ? "凭据已启用。" : "凭据已停用，后续文件操作将无法使用此凭据。";
    });

    private void Upsert(FileCredentialItem item) =>
        _items = _items.Where(x => x.Id != item.Id).Append(item).OrderBy(x => x.Name).ToArray();

    private void ShowFailure(FileCredentialResultCode code)
    {
        if (_disposed) { return; }
        _error = FileCredentialPresentation.Error(code).Message;
        if (code == FileCredentialResultCode.AuthenticationRequired)
        {
            _requiresLogin = true;
            _items = [];
        }
    }

    public void Dispose()
    {
        _disposed = true;
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
