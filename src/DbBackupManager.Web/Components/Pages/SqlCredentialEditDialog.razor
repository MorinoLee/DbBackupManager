@*
    SQL 凭据编辑弹窗。新建时录入名称、用户名与密码；更新密码时只输入新密码，名称与用户名只读展示。
    保存失败弹窗保持打开并保留名称等输入；无论成败，提交后都清空内存中的密码。
*@

<EditForm Model="Model" OnValidSubmit="SubmitAsync">
    <DataAnnotationsValidator />
    <MudDialog>
        <TitleContent>
            <MudText Typo="Typo.h6">@Title</MudText>
        </TitleContent>
        <DialogContent>
            <MudStack Spacing="3">
                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error" role="alert" data-testid="dialog-error">@_error</MudAlert>
                }
                @if (IsCreate)
                {
                    <MudTextField T="string" Label="凭据名称" @bind-Value="Model.Name" For="@(() => Model.Name)" Variant="Variant.Outlined" Disabled="_saving" InputId="credential-name" MaxLength="200" />
                    <MudTextField T="string" Label="SQL 用户名" @bind-Value="Model.Username" For="@(() => Model.Username)" Variant="Variant.Outlined" Disabled="_saving" InputId="credential-username" MaxLength="128" />
                }
                else
                {
                    <MudText Typo="Typo.body2">凭据：@Model.Name（@Model.Username）</MudText>
                }
                <MudTextField T="string" Label="@(IsCreate ? "SQL 密码" : "新密码")" @bind-Value="Model.Password" For="@(() => Model.Password)" InputType="InputType.Password" Variant="Variant.Outlined" Disabled="_saving" InputId="credential-password" MaxLength="128" autocomplete="new-password" />
                <MudText Typo="Typo.caption">@(IsCreate ? "密码将加密保存，保存后不会显示。" : "这里只更新平台保存的密码，不会修改 SQL Server 上的登录密码。")</MudText>
            </MudStack>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="Cancel" Disabled="_saving">取消</MudButton>
            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="_saving"
                       data-testid="dialog-save">
                @(_saving ? "保存中…" : "保存")
            </MudButton>
        </DialogActions>
    </MudDialog>
</EditForm>

@code {
    private bool _saving;
    private string? _error;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public SqlCredentialFormModel Model { get; set; } = default!;

    [Parameter]
    public bool IsCreate { get; set; }

    /// <summary>保存委托；返回 <c>null</c> 表示成功，否则为显示给用户的中文错误。</summary>
    [Parameter, EditorRequired]
    public Func<SqlCredentialFormModel, Task<string?>> OnSave { get; set; } = default!;

    private async Task SubmitAsync()
    {
        if (_saving)
        {
            return;
        }

        _saving = true;
        _error = null;
        try
        {
            var error = await OnSave(Model);
            if (error is null)
            {
                MudDialog.Close(DialogResult.Ok(true));
                return;
            }

            _error = error;
        }
        finally
        {
            Model.Password = string.Empty;
            _saving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
