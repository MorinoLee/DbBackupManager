@page "/login"
@layout AuthLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@using DbBackupManager.Application.Identity
@using Microsoft.AspNetCore.Authorization
@inject IAdminIdentityService IdentityService
@inject NavigationManager Navigation

<PageTitle>登录 - DbBackupManager</PageTitle>

<MudStack Spacing="3">
    <div>
        <h1>登录</h1>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            使用本地管理员账号登录。密码不会回显到页面、地址栏或错误提示中。
        </MudText>
    </div>

    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" data-testid="auth-status">
            @_statusMessage
        </MudAlert>
    }

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" data-testid="auth-error">
            @_errorMessage
        </MudAlert>
    }

    @if (_setupRequired)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" data-testid="setup-required-hint">
            尚未完成首次设置。
            <MudLink Href="@SetupHref" data-testid="login-to-setup">前往首次设置</MudLink>
        </MudAlert>
    }

    <MudPaper Class="pa-6" Elevation="1">
        <form method="post" action="/account/login" data-testid="login-form">
            <AntiforgeryToken />
            @if (_returnUrl is not null)
            {
                <input type="hidden" name="returnUrl" value="@_returnUrl" />
            }

            <MudStack Spacing="3">
                <AuthFormField Id="login-username"
                               Label="用户名"
                               Name="username"
                               Type="text"
                               Autocomplete="username"
                               Autocapitalize="none"
                               Spellcheck="false"
                               TestId="login-username" />
                <AuthFormField Id="login-password"
                               Label="密码"
                               Name="password"
                               Type="password"
                               Autocomplete="current-password"
                               TestId="login-password" />
                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           data-testid="login-submit">
                    登录
                </MudButton>
            </MudStack>
        </form>
    </MudPaper>
</MudStack>

@code {
    private string? _errorMessage;
    private string? _statusMessage;
    private string? _returnUrl;
    private bool _setupRequired;

    [CascadingParameter]
    public HttpContext? PageHttpContext { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "status")]
    public string? Status { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    protected override void OnParametersSet()
    {
        _returnUrl = AuthPageMessages.SanitizeReturnUrl(
            ReturnUrl ?? AuthQuery.Get(Navigation, PageHttpContext, "returnUrl"));
        _errorMessage = AuthPageMessages.ForError(
            Error ?? AuthQuery.Get(Navigation, PageHttpContext, "error"));
        _statusMessage = AuthPageMessages.ForStatus(
            Status ?? AuthQuery.Get(Navigation, PageHttpContext, "status"));
    }

    protected override async Task OnInitializedAsync()
    {
        _setupRequired = await IdentityService.IsSetupRequiredAsync();
    }

    private string SetupHref =>
        _returnUrl is null
            ? "/setup"
            : $"/setup?returnUrl={Uri.EscapeDataString(_returnUrl)}";
}
