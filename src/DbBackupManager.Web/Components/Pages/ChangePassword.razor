@page "/change-password"
@attribute [Authorize(Policy = AdminAuthenticationDefaults.AuthorizationPolicy)]
@attribute [ExcludeFromInteractiveRouting]
@using DbBackupManager.Web.Authentication
@using Microsoft.AspNetCore.Authorization
@inject NavigationManager Navigation

<PageTitle>修改密码 - DbBackupManager</PageTitle>

<MudStack Spacing="3" Class="mx-auto" Style="max-width: 28rem;">
    <h1>修改密码</h1>
    <MudText Typo="Typo.body2" Class="mud-text-secondary">
        修改成功后当前会话会立即失效，需要使用新密码重新登录。密码不会出现在地址栏或提示中。
    </MudText>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <ErrorState Title="无法修改密码" Description="@_errorMessage" />
    }

    <MudPaper Class="pa-6" Elevation="1">
        <form method="post" action="/account/change-password" data-testid="change-password-form">
            <AntiforgeryToken />
            <MudStack Spacing="3">
                <AuthFormField Id="current-password"
                               Label="当前密码"
                               Name="currentPassword"
                               Type="password"
                               Autocomplete="current-password"
                               TestId="current-password" />
                <AuthFormField Id="new-password"
                               Label="新密码"
                               Name="newPassword"
                               Type="password"
                               Autocomplete="new-password"
                               MinLength="12"
                               MaxLength="128"
                               TestId="new-password" />
                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           data-testid="change-password-submit">
                    保存新密码
                </MudButton>
            </MudStack>
        </form>
    </MudPaper>
</MudStack>

@code {
    private string? _errorMessage;

    [CascadingParameter]
    public HttpContext? PageHttpContext { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    protected override void OnParametersSet()
    {
        _errorMessage = AuthPageMessages.ForError(
            Error ?? AuthQuery.Get(Navigation, PageHttpContext, "error"));
    }
}
