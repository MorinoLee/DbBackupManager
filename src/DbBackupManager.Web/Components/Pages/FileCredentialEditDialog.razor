@*
    暂存访问凭据编辑弹窗。新建时可选择 SMB 密码、SFTP 密码或 SFTP 私钥；更新时只提交对应秘密。
    保存失败弹窗保持打开并保留名称等输入；无论成败，提交后都清空内存中的密码、私钥和口令。
*@
@using DbBackupManager.Application.FileCredentials

<EditForm Model="Model" OnValidSubmit="SubmitAsync">
    <DataAnnotationsValidator />
    <MudDialog>
        <TitleContent>
            <MudText Typo="Typo.h6">@Title</MudText>
        </TitleContent>
        <DialogContent>
            <MudStack Spacing="3">
                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error" role="alert" data-testid="dialog-error">@_error</MudAlert>
                }
                @if (IsCreate)
                {
                    <MudSelect T="FileCredentialKind" Label="访问协议" @bind-Value="Model.Kind" Disabled="_saving" data-testid="credential-kind">
                        <MudSelectItem Value="FileCredentialKind.SmbPassword">SMB 密码</MudSelectItem>
                        <MudSelectItem Value="FileCredentialKind.SftpPassword">SFTP 密码</MudSelectItem>
                        <MudSelectItem Value="FileCredentialKind.SftpPrivateKey">SFTP 私钥</MudSelectItem>
                    </MudSelect>
                    <MudTextField T="string" Label="凭据名称" @bind-Value="Model.Name" For="@(() => Model.Name)" Variant="Variant.Outlined" Disabled="_saving" InputId="credential-name" MaxLength="200" />
                    <MudTextField T="string" Label="文件访问用户名" @bind-Value="Model.Username" For="@(() => Model.Username)" Variant="Variant.Outlined" Disabled="_saving" InputId="credential-username" MaxLength="256" />
                }
                else
                {
                    <MudText Typo="Typo.body2">凭据：@Model.Name（@Model.Username）</MudText>
                }
                @if (Model.IsPrivateKey)
                {
                    <MudTextField T="string" Label="@(IsCreate ? "SFTP 私钥" : "新私钥")" @bind-Value="Model.PrivateKey" For="@(() => Model.PrivateKey)"
                                  Variant="Variant.Outlined" Disabled="_saving" InputId="credential-private-key" Lines="6" MaxLength="32768"
                                  HelperText="粘贴 OpenSSH 或 PEM 私钥。保存后不会显示，也不会回显到列表。" />
                    <MudTextField T="string" Label="私钥口令（可选）" @bind-Value="Model.Passphrase" InputType="InputType.Password"
                                  Variant="Variant.Outlined" Disabled="_saving" InputId="credential-passphrase" MaxLength="1024" autocomplete="new-password" />
                    <MudText Typo="Typo.caption">口令只在私钥本身加密时需要；未设置口令请留空。保存后只显示是否已配置口令。</MudText>
                }
                else
                {
                    <MudTextField T="string" Label="@(IsCreate ? "文件访问密码" : "新密码")" @bind-Value="Model.Password" For="@(() => Model.Password)" InputType="InputType.Password" Variant="Variant.Outlined" Disabled="_saving" InputId="credential-password" MaxLength="1024" autocomplete="new-password" />
                    <MudText Typo="Typo.caption">@(IsCreate ? "密码将加密保存，保存后不会显示。" : "这里只更新平台保存的密码，不会修改 SMB/SFTP 服务端密码。")</MudText>
                }
            </MudStack>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="Cancel" Disabled="_saving">取消</MudButton>
            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="_saving"
                       data-testid="dialog-save">
                @(_saving ? "保存中…" : "保存")
            </MudButton>
        </DialogActions>
    </MudDialog>
</EditForm>

@code {
    private bool _saving;
    private string? _error;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public FileCredentialFormModel Model { get; set; } = default!;

    [Parameter]
    public bool IsCreate { get; set; }

    /// <summary>保存委托；返回 <c>null</c> 表示成功，否则为显示给用户的中文错误。</summary>
    [Parameter, EditorRequired]
    public Func<FileCredentialFormModel, Task<string?>> OnSave { get; set; } = default!;

    private async Task SubmitAsync()
    {
        if (_saving)
        {
            return;
        }

        _saving = true;
        _error = null;
        try
        {
            var error = await OnSave(Model);
            if (error is null)
            {
                MudDialog.Close(DialogResult.Ok(true));
                return;
            }

            _error = error;
        }
        finally
        {
            Model.Password = string.Empty;
            Model.PrivateKey = string.Empty;
            Model.Passphrase = string.Empty;
            _saving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
